{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || (newData.child('bannedUntil').val() === data.child('bannedUntil').val() && newData.child('banReason').val() === data.child('banReason').val()))",
        ".validate": "newData.hasChild('username')",
        "username": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30" },
        "bio": { ".validate": "newData.isString() && newData.val().length <= 200" }
      }
    },

    "private": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "sightings": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "uid"],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid) || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['uid', 'catName', 'imageUrl', 'createdAt'])",
        "catName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "likes": {
          "$likeUid": {
            ".write": "auth != null && auth.uid === $likeUid",
            ".validate": "newData.val() === true"
          }
        },
        "comments": {
          "$cid": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid) || root.child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['uid', 'author', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 300"
          }
        }
      }
    },

    "gardens": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "notifications": {
      "global": {
        ".read": "auth != null",
        ".write": "root.child('admins').child(auth.uid).val() === true",
        ".indexOn": ["timestamp"]
      },
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".indexOn": ["timestamp"]
      }
    },

    "content": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
